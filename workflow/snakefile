#read in the sequencing meta-data
seq_file_data = = pd.read_table('../data/file_info_{ref}.txt')

SAMPLES = list(set(seq_file_data['sample_id'].values ))
SAMPLES_smcpp = open("../results/{ref}/smcpp/sample_list_smcpp.txt").read().strip() 
CHROMS = [l.strip() for l in open("../results/{ref}/smcpp/{ref}_chromlist.txt")]

# get a set of all entries of a certain type (eg files)
# from the file info table given a sample_id
def gather_sample_entries(wildcards, what):
    return( seq_file_data[what][ seq_file_data["sample_id"] == wildcards.sample ].values )
def gather_seq_center_id(wildcards):
    return( seq_file_data["seq_center_id"][seq_file_data["sample_id"] == wildcards.sample].values )

